@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================================
   设计令牌 —— 以 ATM收费对比.html 模板为基准
   背景 / 卡片 / 文字为中性色，语义色只出现在费用状态上
   ============================================================ */
:root {
  --bg: #f2f5f3;
  --card: #ffffff;
  --card2: #edf1ee;
  --bd: #d8dfda;
  --bd2: #e5eae6;
  --tx: #1b201d;
  --mut: #5b655e;
  --ac: #188a5f;

  /* 费用状态五级：F=免费 C=限定币种 A=限定ATM T=有FTF P=收费 */
  --stF: #128251;
  --stP: #bd4740;
  --stA: #916508;
  --stC: #187f8e;
  --stT: #7451a8;

  --receipt-shadow: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.14));
}

.dark {
  --bg: #101312;
  --card: #171b19;
  --card2: #1f2522;
  --bd: #2b322e;
  --bd2: #232927;
  --tx: #e9ece9;
  --mut: #98a29b;
  --ac: #2ea274;

  --stF: #46c58e;
  --stP: #e07a74;
  --stA: #d9a63f;
  --stC: #5bb8c9;
  --stT: #b08bd9;

  --receipt-shadow: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.3));
}

html {
  font-size: 16px;
}

body {
  background: var(--bg);
  color: var(--tx);
  font-family: "Noto Sans SC", ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  transition: background-color 0.25s, color 0.25s;
}

button {
  cursor: pointer;
}

input::placeholder {
  color: var(--mut);
}

/* 金额 / 日期 / 符号编号统一等宽 + tabular */
.mono {
  font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
  font-feature-settings: 'tnum' 1;
  font-variant-numeric: tabular-nums;
}

/* 滚动条（表格横向滚动区） */
::-webkit-scrollbar {
  height: 10px;
  width: 10px;
}
::-webkit-scrollbar-thumb {
  background: var(--bd);
  border-radius: 5px;
}
::-webkit-scrollbar-track {
  background: transparent;
}

/* 焦点可见 */
:focus-visible {
  outline: 2px solid var(--ac);
  outline-offset: 2px;
}

.fee-popover {
  position: fixed;
  z-index: 50;
  width: min(300px, calc(100vw - 24px));
  padding: 14px;
  color: var(--tx);
  background: var(--card);
  border: 1px solid var(--bd);
  border-radius: 14px;
  box-shadow: 0 18px 42px rgba(19, 35, 27, 0.16), 0 3px 10px rgba(19, 35, 27, 0.08);
  pointer-events: auto;
  animation: fee-popover-in 0.16s ease-out both;
}

.dark .fee-popover {
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.4), 0 3px 10px rgba(0, 0, 0, 0.24);
}

.fee-popover--right {
  transform-origin: left center;
}

.fee-popover--left {
  transform-origin: right center;
}

.fee-popover--right::before,
.fee-popover--right::after,
.fee-popover--left::before,
.fee-popover--left::after {
  position: absolute;
  top: var(--fee-arrow-y);
  width: 0;
  height: 0;
  content: '';
  transform: translateY(-50%);
}

.fee-popover--right::before {
  left: -8px;
  border-top: 8px solid transparent;
  border-right: 8px solid var(--bd);
  border-bottom: 8px solid transparent;
}

.fee-popover--right::after {
  left: -6px;
  border-top: 6px solid transparent;
  border-right: 6px solid var(--card);
  border-bottom: 6px solid transparent;
}

.fee-popover--left::before {
  right: -8px;
  border-top: 8px solid transparent;
  border-bottom: 8px solid transparent;
  border-left: 8px solid var(--bd);
}

.fee-popover--left::after {
  right: -6px;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
  border-left: 6px solid var(--card);
}

.fee-popover__context {
  border: 1px solid var(--bd2);
}

.fee-popover__verdict {
  margin-top: 12px;
  padding: 11px 12px;
  border: 1px solid;
  border-radius: 11px;
}

.fee-popover__verdict--attention {
  border-width: 1.5px;
  box-shadow: inset 3px 0 0 currentColor;
}

.fee-popover__verdict-label {
  margin-top: 2px;
  font-size: 19px;
  font-weight: 850;
  letter-spacing: -0.025em;
  line-height: 1.2;
}

.fee-popover__verdict--attention .fee-popover__verdict-label {
  font-size: 21px;
}

.fee-popover__verdict-detail {
  margin-top: 4px;
  color: var(--mut);
  font-size: 12px;
  line-height: 1.55;
}

.fee-popover__notes--attention .fee-popover__note {
  font-size: 12.5px;
  font-weight: 600;
}

@media (max-width: 640px) {
  .fee-popover {
    width: min(264px, calc(100vw - 20px));
    padding: 12px;
    border-radius: 12px;
  }

  .fee-popover__header {
    gap: 9px;
  }

  .fee-popover__icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    font-size: 15px;
  }

  .fee-popover__title {
    font-size: 13px;
  }

  .fee-popover__code {
    display: none;
  }

  .fee-popover__description {
    margin-top: 4px;
    font-size: 11.5px;
    line-height: 1.55;
  }

  .fee-popover__context {
    margin-top: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
  }

  .fee-popover__verdict {
    margin-top: 10px;
    padding: 9px 10px;
  }

  .fee-popover__verdict-label {
    font-size: 16.5px;
  }

  .fee-popover__verdict--attention .fee-popover__verdict-label {
    font-size: 18px;
  }

  .fee-popover__verdict-detail {
    margin-top: 3px;
    font-size: 11px;
  }

  .fee-popover__notes {
    margin-top: 10px;
    padding: 8px 10px;
  }

  .fee-popover__notes-label {
    margin-bottom: 4px;
    font-size: 9px;
  }

  .fee-popover__note {
    font-size: 10.5px;
  }

  .fee-popover__notes--attention .fee-popover__note {
    font-size: 11.5px;
  }

  .fee-popover__footer {
    margin-top: 10px;
    padding-top: 8px;
    font-size: 9.5px;
  }
}

@keyframes fee-popover-in {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 减弱动态效果：关闭平滑滚动 */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .fee-popover {
    animation: none;
  }
}
